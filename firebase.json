{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "trailingSlash": true,
    "headers": [
      { "source": "/images/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/api/catalog.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }] },
      { "source": "/app.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
      { "source": "/styles.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  }
}
